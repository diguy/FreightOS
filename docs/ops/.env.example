RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_TIMEOUT_SECONDS=30
RAGFLOW_BM25_WEIGHT=0.7
RAGFLOW_VECTOR_WEIGHT=0.3
RAGFLOW_RERANK_ENABLED=true
RAGFLOW_RERANK_ID=
RAGFLOW_SCORE_THRESHOLD=0.0
DIFY_EXTERNAL_KNOWLEDGE_API_KEY=change-me
DIFY_BASE_URL=http://127.0.0.1:5001
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=30
SESSION_STORE=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_KEY_PREFIX=logistics:session:

# Business data backend: sqlite by default; set to mysql after migration verification.
APP_DATABASE=sqlite

# Business data MySQL settings. Keep this database separate from RAGFlow's MYSQL_DATABASE.
APP_MYSQL_HOST=127.0.0.1
APP_MYSQL_PORT=3306
APP_MYSQL_DATABASE=logistics
APP_MYSQL_USER=logistics
APP_MYSQL_PASSWORD=
APP_MYSQL_CHARSET=utf8mb4
APP_MYSQL_POOL_MIN_SIZE=1
APP_MYSQL_POOL_MAX_SIZE=5

MYSQL_ROOT_PASSWORD=ragflow_root
MYSQL_DATABASE=ragflow
MYSQL_USER=ragflow
MYSQL_PASSWORD=ragflow
MINIO_ROOT_USER=ragflow
MINIO_ROOT_PASSWORD=ragflow_minio
